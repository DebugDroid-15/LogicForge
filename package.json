{
  "name": "logicforge-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "LogicForge — Lightweight, Modern, Cross-Platform FPGA Development Environment",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "node --test tests/**/*.test.js || npm run test:unit",
    "test:unit": "node --test packages/*/dist/**/*.test.js packages/*/dist/*.test.js",
    "dev": "npm --workspace=apps/desktop run dev",
    "cli": "node apps/cli/dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "typescript": "^5.3.3"
  }
}

