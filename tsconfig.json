{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "references": [
    { "path": "./packages/core" },
    { "path": "./packages/toolchain" },
    { "path": "./packages/backends" },
    { "path": "./packages/waveform" },
    { "path": "./packages/schematic" },
    { "path": "./packages/constraints" },
    { "path": "./packages/editor" },
    { "path": "./apps/cli" }
  ]
}

