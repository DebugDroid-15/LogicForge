{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "composite": true
  },
  "references": [
    { "path": "../../packages/core" },
    { "path": "../../packages/toolchain" },
    { "path": "../../packages/backends" },
    { "path": "../../packages/waveform" },
    { "path": "../../packages/schematic" },
    { "path": "../../packages/constraints" },
    { "path": "../../packages/editor" }
  ],
  "include": ["src/**/*"]
}
